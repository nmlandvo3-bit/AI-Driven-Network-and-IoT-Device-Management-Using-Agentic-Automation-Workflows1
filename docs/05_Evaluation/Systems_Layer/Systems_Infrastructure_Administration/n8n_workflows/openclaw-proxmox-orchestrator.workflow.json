              "value": "PVEAPIToken=root@pam!statusbot=26fb88b6-e3d1-4627-be33-c5b9669c663b"
            }
          ]
        },
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "id": "http-list-vms",
      "name": "List VMs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "jsCode": "const vms = Array.isArray($json.data) ? $json.data : [];\nreturn [{ json: { success: true, intent: 'list_vm_status', count: vms.length, data: vms.map(vm => ({ vmid: String(vm.vmid), name: vm.name, node: vm.node, status: vm.status, type: vm.type })) } }];"
      },
      "id": "format-list-vms",
