      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-240, 180]
    },
    {
      "parameters": {
        "jsCode": "const req = $('Parse OpenClaw Request').first().json;\nconst target = req.target || {};\nconst vmid = String(target.vmid || '');\nconst vms = Array.isArray($json.data) ? $json.data : [];\nconst match = vms.find(vm => String(vm.vmid) === vmid);\nif (!match) { return [{ json: { success: false, intent: 'get_vm_status', error: 'vm_not_found', target } }]; }\nreturn [{ json: { success: true, intent: 'get_vm_status', target, data: { vmid: String(match.vmid), name: match.name, node: match.node, status: match.status, type: match.type } } }];"
      },
