      },
      "id": "webhook-openclaw-proxmox-orchestrator",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-1000, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst intent = String(body.intent || '').trim();\nconst target = body.target || null;\nconst confirmed = !!body.confirmed;\nconst requiresConfirmation = !!body.requires_confirmation;\n\nreturn [{ json: {\n  source: body.source || 'openclaw',\n  channel: body.channel || 'telegram',\n  user_id: body.user_id || null,\n  user_name: body.user_name || null,\n  raw_text: body.raw_text || '',\n  intent,\n  target,\n  confirmed,\n  requires_confirmation: requiresConfirmation,\n  request_id: body.request_id || null\n}}];"
      },
      "id": "parse-openclaw-request",
      "name": "Parse OpenClaw Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-760, 300]
    },
    {
      "parameters": {
        "mode": "expression",
        "numberOutputs": 6,
        "output": "={{\n  $json.intent === 'list_vm_status' ? 0 :\n  $json.intent === 'get_vm_status' ? 1 :\n  $json.intent === 'get_all_vm_ips' ? 2 :\n  $json.intent === 'start_vm' ? 3 :\n  $json.intent === 'stop_vm' ? 4 :\n  $json.intent === 'reboot_vm' ? 5 :\n  -1\n}}"
      },
      "id": "route-intent",
      "name": "Route Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [-520, 300]
    },
