    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json.body || $json.query || $json;\nconst rawTarget = input.target ?? input.vmid ?? input.name ?? input.label ?? 'UbuntuTest';\nconst target = String(rawTarget).replace(/[^A-Za-z0-9_. -]/g, '').trim() || 'UbuntuTest';\nconst confirmed = !!input.confirmed;\nconst applyUpgrade = input.apply_upgrade !== false;\nif (!confirmed) {\n  return { json: { target, confirmed, apply_upgrade: applyUpgrade, stop_here: true, success: false, intent: 'safe_patch_vm', error: 'confirmation_required', message: `\u26a0\ufe0f Safe patching for ${target} requires approval. I will create a Proxmox snapshot first, then run OS updates, then perform health checks.` } };\n}\nreturn { json: { target, confirmed, apply_upgrade: applyUpgrade, stop_here: false, requested_at: new Date().toISOString() } };"
      },
      "id": "normalize",
      "name": "Normalize / Confirmation Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
